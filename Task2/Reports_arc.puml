@startuml
title BionicPRO Reports Architecture

actor User
rectangle "Frontend UI" as UI
rectangle "bionicpro-auth\n(BFF)" as BFF
rectangle "reports-service\nGo API" as REPORTS

rectangle "Keycloak" as KC
rectangle "Yandex / LDAP" as IDP

database "CRM (Postgres)" as CRM
database "Telemetry (Postgres)" as TELE

rectangle "Airflow DAG" as AF
database "ClickHouse (OLAP)" as CH
database "ETL Watermark" as WM

User -> UI
UI -> BFF : session cookie
BFF -> KC : validate session
KC -> IDP

BFF -> REPORTS : GET /reports/me
REPORTS -> WM : check period
REPORTS -> CH : SELECT report

AF -> CRM : extract users
AF -> TELE : extract telemetry
AF -> CH : build mart
AF -> WM : update watermark

@enduml